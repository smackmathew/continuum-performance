# Firebase web config for the move-strong project (Firebase console → Project
# settings → General → Your apps → Web app). These values are public by design;
# the Firestore security rules are what protect the data.
# Without VITE_FIREBASE_API_KEY the contact form falls back to opening the
# visitor's email app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=move-strong
VITE_FIREBASE_APP_ID=
