{
  "hosting": [
    {
      "site": "continuum-performance",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(png|svg|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ]
    },
    {
      "site": "move-strong-fitness",
      "public": "hosting/redirect",
      "redirects": [
        {
          "source": "/",
          "destination": "https://continuum-performance.web.app/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://continuum-performance.web.app/:path",
          "type": 301
        }
      ],
      "ignore": [
        "firebase.json",
        "**/.*"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
