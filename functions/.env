# Non-secret settings for the Cloud Functions (committed on purpose).
# Sender for new-lead alerts. onboarding@resend.dev works only for sending to the
# email on your Resend account; verify your own domain in Resend and change this
# to e.g. "Continuum Performance <alerts@yourdomain.com>" to reach anyone.
ALERT_FROM="Continuum Performance <onboarding@resend.dev>"
HUB_URL=https://continuum-performance.web.app/admin/
# Public site address, used for Stripe checkout return pages.
SITE_URL=https://continuum-performance.web.app
